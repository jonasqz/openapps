{
  "name": "openapps",
  "private": true,
  "version": "0.0.0",
  "description": "App-Layer neben Coolify: Control Plane, Plattform-MCP, Starter-Template und Design System.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "prettier": "3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
