    "zod": "3.24.1"
  },
  "devDependencies": {
    "@openapps/app-manifest": "workspace:*",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
