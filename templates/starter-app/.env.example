# Setzt die Control Plane beim Deploy. Lokal von Hand fuellen, nie committen.

# Verbindung auf das eigene Schema, mit der App-Rolle (nie Owner, nie Superuser).
DATABASE_URL=postgres://app_starter:CHANGEME@localhost:5432/openapps?options=-csearch_path%3Dapp_starter

# Geteiltes Signal, mit dem das SDK prueft, dass der Aufruf durch das Gateway kam.
OPENAPPS_GATEWAY_SECRET=CHANGEME
