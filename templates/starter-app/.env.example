# Setzt die Control Plane beim Deploy. Lokal von Hand fuellen, nie committen.

# Verbindung auf das eigene Schema, mit der App-Rolle (nie Owner, nie Superuser).
DATABASE_URL=postgres://app_starter:CHANGEME@localhost:5432/openapps

# Eigenes Schema. Das SDK setzt daraus den search_path — eine DSN mit
# options= oder search_path= wird abgewiesen.
DATABASE_SCHEMA=app_starter

# Das App-eigene Secret, mit dem das SDK die Gateway-Signatur prueft.
# Mindestens 32 Zeichen. Pro Deployment von der Control Plane erzeugt.
OPENAPPS_AUTH_SECRET=CHANGEME-mindestens-32-zeichen-lang

# Gehen byte-gleich ins Signatur-Material ein. Das Gateway schreibt dieselben
# Werte; weicht einer ab, passt keine Signatur. Der Host ist fuer **alle** Apps
# derselbe (ADR 0007: eine Domain, ein Pfad je App) — getrennt werden die Apps
# durch die App-Id und ihr eigenes Secret, nicht durch den Host.
OPENAPPS_APP_ID=starter-app
OPENAPPS_APP_HOST=intern.example

# Der Pfad, unter dem diese App auf der gemeinsamen Domain liegt: /<app-name>
# (ADR 0007). next.config.js setzt ihn als basePath — ohne ihn zeigen Verweise,
# Bilder und JavaScript-Dateien ins Leere. Die Control Plane setzt die Variable
# pro Deployment, und zwar schon beim Build: Next backt den basePath ein.
#
# Lokal bleibt sie leer, dann laeuft die App auf / (pnpm dev). Schreibe den
# Pfad nicht fest in next.config.js — das Review-Gate prueft, dass er aus
# dieser Variable kommt.
OPENAPPS_APP_BASE_PATH=
