# Control Plane — alle Variablen. Nie echte Werte in diese Datei.

# Postgres der Control Plane. Die Rolle legt Schemata und App-Rollen an, ist
# aber selbst weder SUPERUSER noch BYPASSRLS.
DATABASE_URL=postgres://openapps_owner:CHANGE_ME@localhost:5432/openapps
DATABASE_POOL_MAX=10

# Host-Teil der DSN, die jede App als DATABASE_URL bekommt.
APP_DATABASE_HOST=localhost:5432/openapps

# Basis-Domain fuer App-Domains: <app-name>.<APP_BASE_DOMAIN>.
APP_BASE_DOMAIN=apps.example.com

# Forward-Auth, die Traefik pro Aufruf fragt.
FORWARD_AUTH_URL=https://control-plane.example.com/api/auth/forward

# Gemeinsames Secret zwischen Control Plane und @openapps/sdk. Die Signatur im
# Header X-Openapps-Gateway wird damit erzeugt und geprueft.
GATEWAY_SIGNING_SECRET=CHANGE_ME
GATEWAY_SIGNATURE_MAX_AGE_S=120

# Better Auth (Google-SSO).
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://control-plane.example.com
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Deploy-Backend. Nur der Adapter in src/adapters/coolify liest diese Werte.
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=CHANGE_ME
COOLIFY_PROJECT_UUID=CHANGE_ME
COOLIFY_SERVER_UUID=CHANGE_ME
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_TIMEOUT_MS=30000

# Scanner des Review-Gates. Fehlen sie, blockiert das Gate jeden Deploy.
GITLEAKS_BINARY=gitleaks
SEMGREP_BINARY=semgrep

# Claude-Report (advisory). Fehlt der Schluessel, laeuft das Gate ohne ihn.
ANTHROPIC_API_KEY=
