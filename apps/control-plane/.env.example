# Control plane — all variables. Never put real values into this file.

# Postgres of the control plane. The role creates schemas and app roles, but is
# itself neither SUPERUSER nor BYPASSRLS.
DATABASE_URL=postgres://openapps_owner:CHANGE_ME@localhost:5432/openapps
DATABASE_POOL_MAX=10

# Host part of the DSN that every app gets as DATABASE_URL. Without role,
# without password, without options= — the SDK rejects a DSN with search_path
# and sets it itself from DATABASE_SCHEMA.
APP_DATABASE_HOST=localhost:5432/openapps

# The **one** domain under which all apps live (ADR 0007). An app no longer gets
# its own subdomain but the path <APPS_DOMAIN>/<app-name>; the control plane
# derives the path from the app name (src/domain/naming.ts, appPathFor) and
# sets it per deployment as OPENAPPS_APP_BASE_PATH in the app. If the variable
# is missing, the control plane assigns no domain and the deploy stays internal.
# Replaces the former APP_BASE_DOMAIN, which promised one subdomain per app.
APPS_DOMAIN=intern.example.com

# Own domain of the control plane. The public paths (/login, /api/auth/*,
# /healthz) of the forward auth apply only to this host.
CONTROL_PLANE_HOST=control-plane.example.com

# REQUIRED. Address under which Traefik reaches the control plane in the Docker
# network. Without it the generator writes no router for the control plane —
# then Coolify would have to give it a domain, and that router does not carry
# our middlewares. The sign-in would stand unprotected. If the value is missing,
# the control plane does not start.
CONTROL_PLANE_SERVICE_URL=http://openapps-control-plane:3000

# The own Traefik file (ADR 0008). The defaults fit
# infra/betrieb/docker-compose.yml; locally only redirect GATEWAY_DYNAMIC_DIR.
# Where the control plane writes openapps.yaml — mounted in the container, on
# the host /data/coolify/proxy/dynamic. It is written at startup and after
# every deploy.
GATEWAY_DYNAMIC_DIR=/traefik/dynamic
# The address that Traefik's forward auth asks on every request: the control
# plane in the Docker network, not its public URL. Under ADR 0008 there is no
# separate timeout for it any more (Traefik has 30 s built in).
FORWARD_AUTH_ADDRESS=http://openapps-control-plane:3000/api/authz/forward
# Target of the catch-all: answers everything with 403 (infra/traefik/deny-backend).
GATEWAY_DENY_BACKEND_URL=http://openapps-deny-backend:8080
# Names from Coolify's static Traefik configuration. An empty resolver means:
# TLS without Let's Encrypt (local run with its own certificate).
GATEWAY_ENTRYPOINT=https
GATEWAY_CERT_RESOLVER=letsencrypt

# Traefik API for the startup check (apps/control-plane/src/infra/gateway-guard.ts).
# Reachable without auth, because the `traefik` entrypoint deliberately has no
# forward auth — otherwise checking whether the forward auth exists would need
# a session. On the server, Coolify's proxy is called `coolify-proxy`; whether
# its API answers there is open (infra/betrieb/README.md, step 4e). This
# entrypoint must never be published to the internet.
# infra/scripts/check-auth.sh reads the same variable; if it is not set there,
# the script visibly skips the two configuration checks.
TRAEFIK_API_URL=http://coolify-proxy:8080

# The platform MCP (ADR 0009). It runs in the same container and listens only
# on 127.0.0.1; the /mcp route of the control plane passes calls through to it.
# The defaults fit — only change them if the MCP runs elsewhere.
PLATFORM_MCP_URL=http://127.0.0.1:3001
PLATFORM_MCP_HOST=127.0.0.1
PLATFORM_MCP_PORT=3001

# Master secret from which OPENAPPS_AUTH_SECRET is derived per app
# (ADR 0004: one secret per app, not one shared by all). It never leaves the
# control plane — an app only gets its derived secret.
# At least 32 characters.
OPENAPPS_AUTH_MASTER_SECRET=CHANGE_ME_at_least_32_characters_long

# Better Auth (Google SSO). If one of these four variables is missing, the auth
# instance throws on first access — a half-configured auth is worse than none.
# The secret must have at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=CHANGE_ME_at_least_32_characters_long
# Its own base URL, without a path. Google needs
# <BETTER_AUTH_URL>/api/auth/callback/google as the redirect URI.
BETTER_AUTH_URL=https://control-plane.example.com
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# The domain barrier. Comma-separated list of allowed email domains; exact
# match, no subdomains (sub.example.com must be listed explicitly).
# **Empty means: no sign-in**, not every sign-in. Without this line anyone with
# a Google account could create an account on this platform.
AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# First access. Comma-separated email list: whoever is listed here lands in the
# group platform-admins at login — the group that migration 0006 gave the
# wildcard grant. Without this variable nobody gets to the control plane, and
# that is right: better locked out than open. The addresses must also be in
# AUTH_ALLOWED_EMAIL_DOMAINS.
AUTH_BOOTSTRAP_ADMINS=

# Deploy backend. Only the adapter in src/adapters/coolify reads these values.
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=CHANGE_ME
COOLIFY_PROJECT_UUID=CHANGE_ME
COOLIFY_SERVER_UUID=CHANGE_ME
COOLIFY_ENVIRONMENT_NAME=production
# Only for private app repos: the UUID of the GitHub app connected in Coolify
# under "Sources". Empty means: only public repos can be cloned. The branch is
# the one Coolify clones; what gets built is always exactly the commit that the
# review gate checked.
COOLIFY_GITHUB_APP_UUID=
COOLIFY_GIT_BRANCH=main
COOLIFY_TIMEOUT_MS=30000

# Repo backend. Only the adapter in src/adapters/github reads these values.
# Which permissions the token needs: see README, section "Repo backend".
GITHUB_TOKEN=CHANGE_ME
GITHUB_OWNER=blyck
GITHUB_TEMPLATE_REPO=blyck/openapps-starter
GITHUB_REPO_PRIVATE=true
GITHUB_INITIAL_TAG=v0.0.0
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_MS=30000
# The review gate fetches the commit itself (tarball). For that the token needs
# read permission on the contents of the app repos.
GITHUB_CHECKOUT_TIMEOUT_MS=60000
GITHUB_CHECKOUT_MAX_BYTES=104857600

# The one Docker network in which app and gateway live together (spec week 1,
# section 3.3). The label lint in the review gate blocks every further network
# that a working copy claims for itself: a second network or a published host
# port makes the container reachable around the gateway, and then the signature
# from section 3.2 is worthless. The default is the network name that the
# deploy backend uses by itself.
GATEWAY_DOCKER_NETWORK=coolify

# Scanners of the review gate. If they are missing, the gate blocks every deploy.
GITLEAKS_BINARY=gitleaks
SEMGREP_BINARY=semgrep

# Claude report (advisory). If the key is missing, the gate runs without it.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Events and notifications (ADR 0022): how many days events and the
# notifications derived from them are kept before a daily run deletes them.
# Whole days from 1 to 3650. Without the variable: 90.
# OPENAPPS_EVENTS_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Models (ADR 0024): bring your own key, only through the env. There is no
# default model. Without these variables every model function answers
# not_configured and nothing breaks; /healthz shows the state as a note.
# Never put a real key into this file.
#
# Chat (platform agents, Home summary, platform.generate):
# OPENAPPS_CHAT_PROVIDER=anthropic          # anthropic | gemini | openai-compatible
# OPENAPPS_CHAT_MODEL=                      # the provider's model name
# OPENAPPS_CHAT_API_KEY=                    # not needed for a local endpoint
# OPENAPPS_CHAT_BASE_URL=                   # only openai-compatible; default https://api.openai.com/v1
#                                           # local, e.g. Ollama: http://ollama:11434/v1
#
# Embeddings (platform.embed), configured on their own. Anthropic has none.
# OPENAPPS_EMBEDDING_PROVIDER=gemini        # gemini | openai-compatible
# OPENAPPS_EMBEDDING_MODEL=
# OPENAPPS_EMBEDDING_API_KEY=
# OPENAPPS_EMBEDDING_BASE_URL=              # only openai-compatible
# OPENAPPS_EMBEDDING_DIMENSIONS=            # optional whole number
#
# Daily token limits per UTC day, checked before every call. Without the
# variables the defaults apply, never "unlimited".
# OPENAPPS_MODEL_DAILY_TOKENS=1000000
# OPENAPPS_MODEL_DAILY_TOKENS_PER_SUBJECT=200000
#
# Apps whose content never goes to an external provider (comma-separated app
# names). Local is only openai-compatible with a loopback, private or dotless
# base URL. If the list cannot be read, external providers are off.
# OPENAPPS_MODEL_LOCAL_ONLY_APPS=
#
# How many platform agent runs the runner process executes at once (1 to 10).
# OPENAPPS_AGENT_RUN_CONCURRENCY=2

# ---------------------------------------------------------------------------
# What the control plane sets per deployment in the env **of the app**. Do not
# enter it here — this is only for reference on what @openapps/sdk relies on:
#
#   DATABASE_URL          DSN with the app's own role
#   DATABASE_SCHEMA       the one schema of the app
#   OPENAPPS_APP_ID       app name, byte-identical with the signature material
#   OPENAPPS_APP_HOST     the shared domain, trimmed and lowercased
#                         (the same for all apps, ADR 0007)
#   OPENAPPS_APP_BASE_PATH  /<app-name> — the path of the app. The app sets it
#                         as the basePath of its framework; Next bakes it into
#                         the build, so the variable must be set at build time
#   OPENAPPS_AUTH_SECRET  derived from OPENAPPS_AUTH_MASTER_SECRET, per app
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Only for the tests against a real Postgres instance (docker-compose.yml).
# If the variable is missing or the instance is not reachable, these tests are
# skipped, not reported as failures.
TEST_DATABASE_URL=postgres://openapps_owner:openapps_test@localhost:55432/openapps_test
