# Control Plane — alle Variablen. Nie echte Werte in diese Datei.

# Postgres der Control Plane. Die Rolle legt Schemata und App-Rollen an, ist
# aber selbst weder SUPERUSER noch BYPASSRLS.
DATABASE_URL=postgres://openapps_owner:CHANGE_ME@localhost:5432/openapps
DATABASE_POOL_MAX=10

# Host-Teil der DSN, die jede App als DATABASE_URL bekommt. Ohne Rolle, ohne
# Passwort, ohne options= — das SDK weist eine DSN mit search_path ab und setzt
# ihn selbst aus DATABASE_SCHEMA.
APP_DATABASE_HOST=localhost:5432/openapps

# Basis-Domain fuer App-Domains: <app-name>.<APP_BASE_DOMAIN>.
APP_BASE_DOMAIN=apps.example.com

# Eigene Domain der Control Plane. Nur fuer diesen Host gelten die
# oeffentlichen Pfade (/login, /api/auth/*, /healthz) der Forward-Auth.
CONTROL_PLANE_HOST=control-plane.example.com

# Adresse, die Traefik pro Aufruf fragt (Spec Woche 1, Abschnitt 1.1).
FORWARD_AUTH_URL=https://control-plane.example.com/api/authz/forward

# Master-Secret, aus dem pro App OPENAPPS_AUTH_SECRET abgeleitet wird
# (ADR 0004: ein Secret pro App, nicht ein geteiltes fuer alle). Es verlaesst
# die Control Plane nie — eine App bekommt nur ihr abgeleitetes Secret.
# Mindestens 32 Zeichen.
OPENAPPS_AUTH_MASTER_SECRET=CHANGE_ME_min_32_zeichen_lang_bitte

# Better Auth (Google-SSO).
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://control-plane.example.com
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Deploy-Backend. Nur der Adapter in src/adapters/coolify liest diese Werte.
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=CHANGE_ME
COOLIFY_PROJECT_UUID=CHANGE_ME
COOLIFY_SERVER_UUID=CHANGE_ME
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_TIMEOUT_MS=30000

# Repo-Backend. Nur der Adapter in src/adapters/github liest diese Werte.
# Welche Rechte der Token braucht: siehe README, Abschnitt „Repo-Backend".
GITHUB_TOKEN=CHANGE_ME
GITHUB_OWNER=blyck
GITHUB_TEMPLATE_REPO=blyck/openapps-starter
GITHUB_REPO_PRIVATE=true
GITHUB_INITIAL_TAG=v0.0.0
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_MS=30000

# Scanner des Review-Gates. Fehlen sie, blockiert das Gate jeden Deploy.
GITLEAKS_BINARY=gitleaks
SEMGREP_BINARY=semgrep

# Claude-Report (advisory). Fehlt der Schluessel, laeuft das Gate ohne ihn.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Was die Control Plane pro Deployment in die Env **der App** setzt. Nicht hier
# eintragen — hier nur zum Nachlesen, womit @openapps/sdk rechnet:
#
#   DATABASE_URL          DSN mit der eigenen App-Rolle
#   DATABASE_SCHEMA       das eine Schema der App
#   OPENAPPS_APP_ID       App-Name, byte-gleich mit dem Signatur-Material
#   OPENAPPS_APP_HOST     App-Domain, getrimmt und kleingeschrieben
#   OPENAPPS_AUTH_SECRET  aus OPENAPPS_AUTH_MASTER_SECRET abgeleitet, pro App
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Nur fuer die Tests gegen eine echte Postgres-Instanz (docker-compose.yml).
# Fehlt die Variable oder ist die Instanz nicht erreichbar, werden diese Tests
# uebersprungen, nicht als Fehler gemeldet.
TEST_DATABASE_URL=postgres://openapps_owner:openapps_test@localhost:55432/openapps_test
