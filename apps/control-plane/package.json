{
  "name": "@openapps/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control Plane: Rechtemodell, Review-Gate, Audit-Log und Deploy-Steuerung.",
  "exports": {
    ".": "./src/domain/index.ts",
    "./domain": "./src/domain/index.ts",
    "./review-gate": "./src/domain/review-gate/index.ts",
    "./infra/memory": "./src/infra/memory/repositories.ts",
    "./infra/memory/doubles": "./src/infra/memory/doubles.ts",
    "./gateway": "./src/lib/gateway.ts",
    "./infra/pg": "./src/infra/pg/index.ts",
    "./infra/scanners": "./src/infra/scanners.ts",
    "./adapters/coolify": "./src/adapters/coolify/index.ts",
    "./runtime": "./src/lib/runtime.ts"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"**/*.{ts,tsx,sql,json,md}\"",
    "test": "vitest run",
    "migrate": "tsx src/infra/pg/migrate.ts"
  },
  "dependencies": {
    "@openapps/app-manifest": "workspace:*",
    "@openapps/ui": "workspace:*",
    "better-auth": "1.2.7",
    "next": "15.1.6",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
