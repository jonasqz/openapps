{
  "name": "@openapps/platform-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform MCP: the control plane tools, the prompts how_to_build_app and get_started, forwarding of app tools, and the runner for platform agent runs.",
  "exports": {
    ".": "./src/server.ts",
    "./tools": "./src/tools.ts",
    "./app-tools": "./src/app-tools.ts"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/http.ts",
    "build": "echo \"no build step: runs from the TypeScript source via tsx\"",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:lokal": "LOKAL_E2E=1 vitest run tests/lokal-e2e.spec.ts",
    "start:runner": "tsx src/runner.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "@openapps/app-manifest": "workspace:*",
    "@openapps/control-plane": "workspace:*",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
