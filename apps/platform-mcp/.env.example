# Plattform-MCP — alle Variablen. Nie echte Werte in diese Datei.

# Derselbe Postgres wie die Control Plane: der MCP hat keine eigene Datenbank.
DATABASE_URL=postgres://openapps_owner:CHANGE_ME@localhost:5432/openapps
APP_DATABASE_HOST=localhost:5432/openapps
APP_BASE_DOMAIN=apps.example.com
FORWARD_AUTH_URL=https://control-plane.example.com/api/auth/forward

# Signatur, mit der weitergeleitete Aufrufe die Identitaet des Agents tragen.
# Muss mit der Control Plane und @openapps/sdk uebereinstimmen.
GATEWAY_SIGNING_SECRET=CHANGE_ME

# Identitaet dieses MCP-Laufs im stdio-Betrieb (ein OAuth-Client pro Agent).
# Im HTTP-Betrieb kommt sie pro Aufruf aus dem Authorization-Header.
PLATFORM_MCP_CLIENT_ID=CHANGE_ME
PLATFORM_MCP_CLIENT_SECRET=CHANGE_ME
PLATFORM_MCP_PORT=3001

# Pfad zu AGENTS.md fuer den Prompt how_to_build_app. Ohne Angabe wird vom
# Arbeitsverzeichnis aus nach oben gesucht.
AGENTS_MD_PATH=

# Deploy-Backend (nur vom Adapter der Control Plane gelesen).
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=CHANGE_ME
COOLIFY_PROJECT_UUID=CHANGE_ME
COOLIFY_SERVER_UUID=CHANGE_ME

# Scanner des Review-Gates.
GITLEAKS_BINARY=gitleaks
SEMGREP_BINARY=semgrep
