# Platform MCP — all variables. Never put real values into this file.

# The same Postgres as the control plane: the MCP has no database of its own.
DATABASE_URL=postgres://openapps_owner:CHANGE_ME@localhost:5432/openapps
APP_DATABASE_HOST=localhost:5432/openapps
# The one domain under which all apps live; an app is reachable at
# <APPS_DOMAIN>/<app-name> (ADR 0007).
APPS_DOMAIN=intern.example.com
CONTROL_PLANE_HOST=control-plane.example.com
FORWARD_AUTH_URL=https://control-plane.example.com/api/authz/forward

# Master secret of the control plane. From it the MCP derives, per app, the
# secret with which it signs a forwarded call — it knows no app secret.
# Must be identical to the one of the control plane.
OPENAPPS_AUTH_MASTER_SECRET=CHANGE_ME_at_least_32_characters_long

# Identity of this MCP run in stdio operation (one OAuth client per agent).
# In HTTP operation it comes from the Authorization header on every call.
PLATFORM_MCP_CLIENT_ID=CHANGE_ME
PLATFORM_MCP_CLIENT_SECRET=CHANGE_ME
PLATFORM_MCP_PORT=3001

# Path to AGENTS.md for the how_to_build_app prompt. If not set, it is searched
# upwards from the working directory.
AGENTS_MD_PATH=

# Deploy and repo backend (read only by the adapters of the control plane).
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=CHANGE_ME
COOLIFY_PROJECT_UUID=CHANGE_ME
COOLIFY_SERVER_UUID=CHANGE_ME
GITHUB_TOKEN=CHANGE_ME
GITHUB_OWNER=blyck
GITHUB_TEMPLATE_REPO=blyck/openapps-starter

# Scanners of the review gate.
GITLEAKS_BINARY=gitleaks
SEMGREP_BINARY=semgrep
