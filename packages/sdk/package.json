{
  "name": "@openapps/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Client für Apps auf der Plattform: Nutzer aus den Gateway-Headern und ein Postgres-Client, der auf das eigene Schema festgelegt ist.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
