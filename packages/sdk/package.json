{
  "name": "@openapps/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Client for apps on the platform: the user from the gateway headers and a Postgres client pinned to the app's own schema.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "peerDependencies": {
    "next": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "next": "15.1.3",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
