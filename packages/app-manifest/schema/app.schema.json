{
  "$id": "https://openapps.dev/schema/app-manifest/v1/app.schema.json",
  "title": "openapps App-Manifest (app.json)",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "requiredTables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "offeredTools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "verb": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "execute"
            ]
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "description",
          "verb",
          "operationId"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "requestedGrants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subjectKind": {
            "type": "string",
            "enum": [
              "human",
              "group",
              "app",
              "agent"
            ]
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "verb": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "execute"
            ]
          },
          "resource": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "app",
                  "table",
                  "view",
                  "tool"
                ]
              },
              "app": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9_.]+$"
              }
            },
            "required": [
              "kind",
              "app"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "subjectKind",
          "verb",
          "resource",
          "reason"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "secret": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "default": {
            "type": "string",
            "maxLength": 500
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "secret",
          "description"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(\\*\\.)?[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "https",
              "http",
              "tcp"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "host",
          "protocol",
          "reason"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "source": {
      "type": "object",
      "properties": {
        "git": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(https:\\/\\/|git@)"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "git",
        "tag"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "manifestVersion",
    "name",
    "displayName",
    "description",
    "category",
    "version",
    "source"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
