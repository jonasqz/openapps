{
  "name": "@openapps/ui",
  "version": "0.1.0",
  "description": "Design System von openapps: Tokens, Komponenten, Muster, App-Shell und UI-Linter.",
  "type": "module",
  "sideEffects": [
    "./src/tokens/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./tailwind-preset": "./tailwind/preset.js",
    "./eslint-config": "./lint/eslint.config.js",
    "./lint/rules": "./lint/rules/index.js",
    "./allowed-packages.example.json": "./lint/allowed-packages.example.json"
  },
  "files": [
    "src",
    "lint",
    "tailwind",
    "README.md"
  ],
  "scripts": {
    "tokens": "node --experimental-strip-types src/tokens/generate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/parser": "8.18.0",
    "@typescript-eslint/rule-tester": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
