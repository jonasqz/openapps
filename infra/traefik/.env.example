# Nur Ports fuer den lokalen Nachweis-Stapel. Keine Secrets — die Werte fuer
# einen Host (ACME-Adresse, Domains) stehen in Coolifys statischer
# Konfiguration bzw. in der Env der Control Plane, nicht hier (ADR 0008).
# Kopieren nach `.env`, wenn die Standardports belegt sind.

# HTTPS-Entrypoint `https` auf dem Host (Coolifys Name, nicht `websecure`).
OPENAPPS_HTTPS_PORT=8443
# HTTP-Entrypoint `http` auf dem Host.
OPENAPPS_HTTP_PORT=8080
# Traefik-API, ausschliesslich auf 127.0.0.1 veroeffentlicht.
OPENAPPS_TRAEFIK_API_PORT=8081
