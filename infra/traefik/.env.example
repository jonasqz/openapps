# Nur Ports fuer den lokalen Nachweis-Stapel. Keine Secrets — die Platzhalter
# in `traefik.yml` (ACME-Adresse) werden pro Host gesetzt, nicht hier.
# Kopieren nach `.env`, wenn die Standardports belegt sind.

# HTTPS-Entrypoint `websecure` auf dem Host.
OPENAPPS_HTTPS_PORT=8443
# HTTP-Entrypoint `web` auf dem Host (leitet nur auf HTTPS um).
OPENAPPS_HTTP_PORT=8080
# Traefik-API, ausschliesslich auf 127.0.0.1 veroeffentlicht.
OPENAPPS_TRAEFIK_API_PORT=8081
