# Set by the control plane on deploy. Fill in by hand locally, never commit.

# Connection to the app's own schema, with the app role (never owner, never superuser).
DATABASE_URL=postgres://app_tasks:CHANGEME@localhost:5432/openapps

# The app's own schema. The SDK derives the search_path from it — a DSN with
# options= or search_path= is rejected.
DATABASE_SCHEMA=app_tasks

# The app's own secret, used by the SDK to verify the gateway signature.
# At least 32 characters. Generated by the control plane per deployment.
OPENAPPS_AUTH_SECRET=CHANGEME-at-least-32-characters-long

# These go byte-for-byte into the signature material. The gateway writes the
# same values; if one differs, no signature matches. The host is the same for
# **all** apps (ADR 0007: one domain, one path per app) — apps are told apart
# by their app id and their own secret, not by the host.
OPENAPPS_APP_ID=tasks
OPENAPPS_APP_HOST=intern.example

# The path this app lives under on the shared domain: /<app-name>
# (ADR 0007). next.config.js uses it as basePath — without it, links, images
# and JavaScript files point nowhere. The control plane sets the variable per
# deployment, already at build time: Next bakes the basePath into the build.
#
# Locally it stays empty, so the app runs on / (pnpm dev). Do not hard-code
# the path in next.config.js — the review gate checks that it comes from this
# variable.
OPENAPPS_APP_BASE_PATH=
